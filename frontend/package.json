{
  "name": "yuexiang-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test && playwright test --config playwright.backend-unavailable.config.ts",
    "test:visual:matrix": "npm run build && playwright test e2e/visual-matrix.spec.ts",
    "test:visual:matrix:update": "npm run build && playwright test e2e/visual-matrix.spec.ts --update-snapshots",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.0.0",
    "@playwright/test": "^1.48.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
