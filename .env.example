# ============================================================
# 粤乡智匠 环境变量模板
# ------------------------------------------------------------
# 用法：复制本文件为 .env，按需修改；.env 已被 .gitignore 忽略。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# 所有变量都通过仓库根 .env 注入，修改后必须重启后端才生效。
# 完整说明与故障排查见 ENVIRONMENT.md。
# ============================================================

# ------------------------------------------------------------
# 1. 基础运行
# ------------------------------------------------------------

# 会话签名密钥。生产环境必须改成随机字符串（如 `python -c "import secrets;print(secrets.token_hex(32))"`）。
# 留空时每次启动随机生成，重启即失效，仅适合本地调试。
SECRET_KEY=change-me-to-a-random-string

# Flask 监听端口。留空、删行或填非法值 = 默认 5000；
# 填合法端口则改听该端口。多个工作树并行时给各自 .env 填不同端口。
PORT=5000

# 生产 nginx 监听端口（仅 tools/render_nginx_config.py 与 nginx 运行器读取）。
NGINX_PORT=8081

# SQLite 库路径覆盖。留空 = 使用仓库根 data/yuexiang.db。
# 测试与 e2e 用它指向可弃副本，避免写坏真实数据。
YUEXIANG_DB=

# ------------------------------------------------------------
# 2. AI 服务（OpenAI 兼容端点，任一服务商均可）
# ------------------------------------------------------------
# 以下默认值与 backend/ai/client.py 保持一致，仅填 AI_API_KEY 即可跑通。

# 文本模型端点。换服务商时改这一行即可。
AI_API_URL=https://api.siliconflow.cn/v1/chat/completions

# 模型密钥。留空时 AI 接口返回 503 + 明确错误码，不会返回伪造结果；
# 平台其余功能（内容浏览、岗位、社区、后台）不受影响。
AI_API_KEY=

# 文本模型：病害结构化诊断，也是对话模型的兜底。
AI_MODEL=Qwen/Qwen3-32B

# 视觉模型：图片诊断专用。留空即关闭图片诊断（不会静默降级到知识库）。
AI_VL_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 对话模型：农技问答 / 追问建议 / 方言语音问答 / 建议栏。
# 留空 = 跟随 AI_MODEL。换非推理模型可显著降低流式首字延迟。
# 该模型必须支持纯文本对话；只支持图片的模型不能填在这里。
AI_CHAT_MODEL=

# 推理强度：仅推理模型有效（如 low / medium / high）。
# 推理模型的思考会占用 max_tokens 额度，思考吃光额度时正文会是空串。
AI_REASONING_EFFORT=

# 思考余量（token），叠加到各处 max_tokens 预算上，保证「思考完还有正文」。
AI_REASONING_TOKEN_RESERVE=600

# ------------------------------------------------------------
# 3. 安全与跨域
# ------------------------------------------------------------

# 是否信任反向代理透传的 X-Forwarded-For。默认 0。
# 仅当部署在会覆写该请求头的可信反代之后才设为 1，否则限流键可被伪造绕过。
TRUST_PROXY=0

# 额外放行的跨域来源（逗号分隔）。本机 localhost / 127.0.0.1 已默认放行，
# 独立域名前端才需要填写，例如 https://demo.example.com
CORS_ORIGINS=

# ------------------------------------------------------------
# 4. 限流额度（滑动窗口 300 秒内的请求上限，一般无需修改）
# ------------------------------------------------------------

# 农技问答 / 追问建议
AGRI_RATE_ASK_LIMIT=60
AGRI_RATE_SUGGEST_LIMIT=120

# 病虫害诊断 / 方言语音问答 / AI 简历辅助
DIAG_RATE_LIMIT=60
VOICE_RATE_LIMIT=60
RESUME_AI_RATE_LIMIT=30

# 电商：带货话术 / 话术评分 / 商品文案 / 客服对练 / 客服辅助 / 观众提问
EC_RATE_SCRIPT_LIMIT=30
EC_RATE_FEEDBACK_LIMIT=30
EC_RATE_COPY_LIMIT=30
EC_RATE_CS_LIMIT=120
EC_RATE_CS_AUX_LIMIT=40
EC_RATE_COMMENTS_LIMIT=30

# ------------------------------------------------------------
# 5. 开发调试（生产环境保持默认）
# ------------------------------------------------------------

# 设为 1 开启 Flask 调试模式。会暴露 Werkzeug 交互式调试器，
# 仅在完全可信的本机环境使用。
FLASK_DEBUG=0

# 启动时是否自动打开浏览器。设为 0 可关闭（脚本化启动时建议关闭）。
OPEN_BROWSER=1

# 启动后打开的地址。留空 = 打开后端健康检查页；
# 本地同时跑前端时建议设为 http://127.0.0.1:5173
STARTUP_URL=

# 后端代码热重载。仅开发期使用，start-dev.bat 会自动设为 1。
YX_DEV_RELOAD=0

# ------------------------------------------------------------
# 6. 前端开发代理（可选，供 vite.config.ts 读取）
# ------------------------------------------------------------

# 覆盖 Vite 开发代理目标。留空 = http://127.0.0.1:${PORT}
VITE_PROXY_TARGET=
