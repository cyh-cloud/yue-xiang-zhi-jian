# 粤乡智匠 环境变量配置
# 复制此文件为 .env 并填入真实值

# Flask密钥（用于会话签名，生产环境请用随机字符串）
SECRET_KEY=change-me-to-a-random-string

# 服务端口。留空、删行或填非法值 = 用默认端口 5000；
# 填了合法端口则启动时改听该端口。多个工作树各跑一个实例时，
# 给各自 .env 填不同端口，避免后起的实例撞「端口已被占用」。
PORT=5000

# AI服务配置（示例为阶跃星辰 StepFun；任何 OpenAI 兼容端点都可）
AI_API_URL=https://api.stepfun.com/step_plan/v1/chat/completions
AI_API_KEY=your-api-key
# 文本模型：病害诊断（无图），也是对话模型的兜底
AI_MODEL=step-3.7-flash
# 视觉模型：图片诊断专用。留空即关闭图片诊断（不会静默降级到知识库）
AI_VL_MODEL=step-3.7-flash
# 对话模型：农技问答 / 追问建议 / 方言语音问答 / 建议栏。留空 = 跟随 AI_MODEL。
# 用一个非推理的对话模型可以让流式首字快很多（实测 0.4s vs 推理模型的 3.2s）。
# ⚠️ 该模型必须支持纯文本对话；不要把只支持图片的模型填在这里。
# 若换成只支持文本+音频的模型（如 stepaudio-2.5-chat），注意它不能吃图片、
# 结构化 JSON 输出也不可靠 —— 图片诊断与病害诊断不要指向它。
AI_CHAT_MODEL=
# 推理强度（仅推理模型有效，如 step-3.7-flash 支持 low/medium/high）。
# ⚠️ 推理模型的思考会占用 max_tokens 额度，思考吃光额度时正文会是空串。
# 实测「关闭思考」的各种参数写法（enable_thinking / thinking.type=disabled /
# reasoning_effort=none|minimal / enable_reason / chat_template_kwargs）均无效，
# 只能调低强度 + 给 max_tokens 留出思考余量。
AI_REASONING_EFFORT=low
# 思考余量（token），叠加到各处 max_tokens 预算上
AI_REASONING_TOKEN_RESERVE=600
# 注意：stepaudio-2.5-realtime 是「实时语音」模型（WebSocket 协议），
# 不走 /chat/completions，不能用作文字问答模型（实测返回 404 model_invalid）；
# 同系列的 stepaudio-2.5-chat 可以。

# ---- 安全开关 ----
# 是否信任反向代理透传的 X-Forwarded-For（默认 0）。本机直连保持 0；
# 仅当部署在会覆写该请求头的可信反代之后才设为 1，否则限流键可被伪造绕过。
TRUST_PROXY=0
# 额外放行的跨域来源（逗号分隔，支持正则）。本机 localhost / 127.0.0.1 已默认放行。
CORS_ORIGINS=
