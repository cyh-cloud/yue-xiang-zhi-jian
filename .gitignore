# ---- 环境变量与密钥（严禁提交）----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.venv/
venv/

# ---- 备份 / 临时文件 ----
*.bak
*.bak-*
*.orig
*.rej
*~
*.tmp
*.log

# ---- SQLite 运行时文件 ----
*.db-journal
*.db-wal
*.db-shm

# ---- SQLite 库本体 ----
# 库里存的是用户数据与内容数据，不进版本库。新环境用基线库文件还原。
data/*.db

# ---- 服务运行时产物 ----
data/server.pid

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

